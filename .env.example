# --- Supabase PostgreSQL ---
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# --- NextAuth ---
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# --- Upstash Redis (OTP / verification state) ---
UPSTASH_REDIS_REST_URL="https://your-project.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_BOT_USERNAME="yourbot"
TELEGRAM_WEBHOOK_SECRET="change-me"

# --- Super Admin ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# --- Public app URL ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Sentry (optional) ---
# SENTRY_DSN=""

# --- Cron secret ---
CRON_SECRET="change-me"

# --- Admin Telegram chat ID for alerts ---
ALERT_TELEGRAM_CHAT_ID=""
