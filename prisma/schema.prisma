generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pgbouncer transaction pooler (port 6543)
  directUrl = env("DIRECT_URL")   // direct connection for migrations (port 5432)
}

enum Role {
  SUPER_ADMIN
  BUSINESS_OWNER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum TriggerType {
  VISIT
  PURCHASE
}

enum TransactionType {
  EARN
  REDEEM
}

model Business {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  ownerId   String   @unique
  owner     User     @relation("OwnedBusiness", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  // Catalog fields — no hard enum for category on purpose: a small, evolving set of
  // free-text values ("barber", "market", "medicine"...) isn't worth a migration every
  // time a new business type shows up.
  // Not collected at signup time (the signup form only asks name/phone/password) —
  // defaults so business.create() during Telegram verification doesn't need it up
  // front; the owner can set a real category from the dashboard later.
  category         String  @default("general")
  description      String?
  address          String?
  lat              Float?
  lng              Float?
  logoUrl          String?
  welcomePoints    Int     @default(0)
  minCashback      Float   @default(0)
  telegramGroupUrl String?

  staff        User[]        @relation("BusinessStaff")
  memberships  Membership[]
  tiers        LoyaltyTier[]
  rules        LoyaltyRule[]
  transactions Transaction[]
}

// Note: SUPER_ADMIN is not represented as a User row — it authenticates against
// ADMIN_USERNAME/ADMIN_PASSWORD env vars directly (see server/auth.ts).
// User = business owners and staff ONLY. Deliberately kept separate from Customer:
// owners/staff authenticate with a password/PIN, customers never do — merging them
// into one "account for everyone" model would mean adding a password field that sits
// unused on every customer, and would quietly undermine the whole "no passwords for
// clients" pitch the product is built around.
model User {
  id           String  @id @default(uuid())
  name         String
  phoneNumber  String  @unique
  passwordHash String?
  pin          String?
  role         Role
  verified     Boolean @default(false)
  telegramChatId String?

  ownedBusiness Business? @relation("OwnedBusiness")

  businessId String?
  business   Business? @relation("BusinessStaff", fields: [businessId], references: [id])

  redemptionsInitiated Transaction[] @relation("StaffTransactions")

  createdAt DateTime @default(now())
}

// Customer = a single global identity for the end user, phone+Telegram-OTP only,
// never a password. Replaces the old business-scoped `Client` model — a customer
// signs in once and can hold a Membership in any number of businesses.
model Customer {
  id             String   @id @default(uuid())
  name           String?
  phoneNumber    String   @unique
  telegramChatId String?
  createdAt      DateTime @default(now())

  memberships Membership[]
  tickets     SupportTicket[]
}

// One row per (customer, business) — this is where points actually live.
model Membership {
  id         String           @id @default(uuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id])
  businessId String
  business   Business         @relation(fields: [businessId], references: [id])
  points     Int              @default(0)
  status     MembershipStatus @default(ACTIVE)

  tierId String?
  tier   LoyaltyTier? @relation(fields: [tierId], references: [id])

  transactions Transaction[]

  createdAt DateTime @default(now())

  @@unique([customerId, businessId])
}

model LoyaltyTier {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String // BRONZE / SILVER / GOLD
  minPoints  Int
  discount   Int // percent
  color      String   @default("#999999")

  memberships Membership[]

  @@unique([businessId, name])
}

model LoyaltyRule {
  id            String      @id @default(uuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id])
  name          String
  triggerType   TriggerType
  pointsAwarded Int
}

model Transaction {
  id           String          @id @default(uuid())
  businessId   String
  business     Business        @relation(fields: [businessId], references: [id])
  membershipId String
  membership   Membership      @relation(fields: [membershipId], references: [id])
  staffId      String?
  staff        User?           @relation("StaffTransactions", fields: [staffId], references: [id])
  amount       Int
  type         TransactionType
  description  String?
  createdAt    DateTime        @default(now())
}

model SupportTicket {
  id         String   @id @default(uuid())
  // Not strictly FK'd to Customer — a business owner or staff member might also file
  // a ticket, and neither of those is a Customer row. Capturing phone/name at
  // submission time is simpler than an optional-FK-to-two-tables mess.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  phone      String
  name       String?
  subject    String
  message    String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
}
