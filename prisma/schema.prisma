generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  STAFF
  ADMIN
}

enum StaffRole {
  CASHIER
  MANAGER
  OWNER
}

enum TransactionType {
  EARN
  REDEEM
  ADJUSTMENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LoyaltyRuleType {
  REFERRAL
  BIRTHDAY
  ANNIVERSARY
  SPENDING_THRESHOLD
  VISIT_COUNT
  INACTIVITY
  TIER_UPGRADE
  PROMOTIONAL
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  name        String?
  password    String?
  role        Role     @default(STAFF)
  businessId  String?
  staffRole   StaffRole @default(CASHIER)
  pin         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownedBusiness  Business?  @relation("BusinessOwner")
  staffBusiness  Business? @relation("BusinessStaff", fields: [businessId], references: [id], onDelete: Cascade)
  staffTickets   SupportTicket[] @relation("StaffTickets")

  @@map("users")
}

model Customer {
  id            String    @id @default(cuid())
  phone         String    @unique
  name          String?
  telegramId    String?   @unique
  telegramUsername String?
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   Membership[]
  transactions  Transaction[]
  tickets       SupportTicket[]
  referrals     SupportTicket[] @relation("ReferredBy")

  @@map("customers")
}

model Business {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  category         String?
  address          String?
  latitude         Float?
  longitude        Float?
  logo             String?
  isActive         Boolean  @default(true)
  telegramGroup    String?
  welcomePoints    Int      @default(0)
  minimumCashback  Int      @default(0)
  pointsExpiryDays Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownerId          String   @unique
  owner            User      @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships      Membership[]
  transactions     Transaction[]
  loyaltyRules     LoyaltyRule[]
  supportTickets   SupportTicket[]
  staff            User[]    @relation("BusinessStaff")
  locations        BusinessLocation[]

  @@map("businesses")
}

model BusinessLocation {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  address     String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_locations")
}

model Membership {
  id           String   @id @default(cuid())
  customerId   String
  businessId   String
  points       Int      @default(0)
  tier         String   @default("basic")
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([customerId, businessId])
  @@map("memberships")
}

model Transaction {
  id            String          @id @default(cuid())
  type          TransactionType
  amount        Int
  description   String?
  membershipId  String
  businessId    String
  customerId    String
  actorId       String?
  actorType     String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  membership    Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adjustments   Transaction[]   @relation("TransactionAdjustment")
  original      Transaction?    @relation("TransactionAdjustment", fields: [originalTransactionId], references: [id], onDelete: SetNull)
  originalTransactionId String?

  @@map("transactions")
}

model LoyaltyRule {
  id          String            @id @default(cuid())
  type        LoyaltyRuleType
  name        String
  description String?
  isActive    Boolean           @default(true)
  config      Json
  businessId  String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("loyalty_rules")
}

model SupportTicket {
  id          String              @id @default(cuid())
  customerId  String
  businessId  String
  subject     String
  message     String
  status      SupportTicketStatus @default(OPEN)
  priority    String              @default("normal")
  assignedToId String?
  resolvedAt  DateTime?
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedTo  User?     @relation("StaffTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  referrer    Customer? @relation("ReferredBy", fields: [referrerId], references: [id], onDelete: SetNull)
  referrerId  String?

  @@map("support_tickets")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorType   String?
  action      String
  businessId  String?
  customerId  String?
  resourceType String?
  resourceId  String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}
