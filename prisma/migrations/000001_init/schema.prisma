generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model Account {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          AccountRole @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  accountId    String
  expires      DateTime
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
}

model Customer {
  id            String    @id @default(cuid())
  accountId     String    @unique
  phone         String    @unique
  telegramId    String?   @unique
  firstName     String?
  lastName      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isAnonymous   Boolean   @default(false)
  anonExpiresAt DateTime?
}

model Business {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  description     String?
  category        String?
  address         String?
  latitude        Float?
  longitude       Float?
  logoUrl         String?
  welcomePoints   Int       @default(0)
  minimumCashback Int       @default(0)
  telegramGroupId String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  points    Int      @default(0)
  tier      String   @default("BRONZE")
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id             String            @id @default(cuid())
  type           TransactionType
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  idempotencyKey String            @unique
  reason         String?
  referenceId    String?
  createdAt      DateTime          @default(now())
  actorType      ActorType
  actorId        String
}

model Adjustment {
  id        String   @id @default(cuid())
  reason    String
  createdAt DateTime @default(now())
  actorId   String
  actorType ActorType
}

model LoyaltyRule {
  id        String   @id @default(cuid())
  type      RuleType
  isActive  Boolean  @default(true)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id          String           @id @default(cuid())
  subject     String
  message     String
  status      TicketStatus     @default(OPEN)
  priority    TicketPriority   @default(NORMAL)
  source      TicketSource
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?
}

model SupportMessage {
  id        String   @id @default(cuid())
  text      String
  source    TicketSource
  createdAt DateTime @default(now())
}

model StaffAccount {
  id            String    @id @default(cuid())
  pinHash       String
  failedAttempts Int      @default(0)
  lockedUntil    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StaffPermission {
  id        String    @id @default(cuid())
  role      StaffRole
  isActive  Boolean   @default(true)
}

model StaffInvite {
  id        String   @id @default(cuid())
  code      String   @unique
  role      StaffRole @default(CASHIER)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorType ActorType
  actorId   String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())
}

model OtpCode {
  id           String   @id @default(cuid())
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0)
  maxAttempts  Int      @default(5)
  consumedAt   DateTime?
  createdAt    DateTime @default(now())
}

enum AccountRole {
  SUPER_ADMIN
  OWNER
  STAFF
  CUSTOMER
}

enum ActorType {
  CUSTOMER
  OWNER
  STAFF
  SYSTEM
  ADMIN
}

enum TransactionType {
  EARN
  REDEEM
  ADJUSTMENT
  EXPIRE
  WELCOME
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketSource {
  CUSTOMER
  STAFF
  ADMIN
  SYSTEM
}

enum RuleType {
  REFERRAL
  BIRTHDAY
  ANNIVERSARY
  SPENDING_THRESHOLD
  VISIT_COUNT
  INACTIVITY
  TIER_UPGRADE
  PROMO
}

enum StaffRole {
  CASHIER
  MANAGER
  OWNER
}
